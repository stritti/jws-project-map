{
  "name": "jws-project-map",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev",
    "build": "run-p type-check build-only",
    "budget": "node scripts/check-bundle-budget.cjs",
    "build:prod": "bun run build && bun run budget",
    "lint": "eslint .",
    "build-only": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "update:browserlist": "bunx browserslist@latest --update-db",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/img/cropped-joerg-wolff-stiftung.png",
    "optimize-images": "bun run scripts/optimize-images.mjs",
    "mcp": "bun run scripts/mcp-server.ts",
    "semantic-release": "semantic-release",
    "semantic-release:dry-run": "semantic-release --dry-run",
    "semantic-release:debug": "semantic-release --debug",
    "commit": "git-cz"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "axios": "^1.18.1",
    "baseline-browser-mapping": "^2.11.14",
    "caniuse-lite": "^1.0.30001806",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.path.drag": "^0.0.6",
    "marked": "^18.0.5",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vite-plugin-package-version": "^1.1.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6",
    "vue-leaflet-markercluster": "^0.6.1",
    "vue-router": "^5.1.0",
    "vue3-markdown-it": "^1.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify-json/bi": "^1.2.7",
    "@lhci/cli": "^0.15.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@netlify/plugin-lighthouse": "^6.0.4",
    "@rushstack/eslint-patch": "^1.16.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.35",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.10.0",
    "git-cz": "^4.9.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "semantic-release": "^25.0.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.3.7",
    "workbox-build": "^7.1.0",
    "rollup": "^4.62.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.22.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "commitlint": {
      "extends": [
        "@commitlint/config-conventional"
      ]
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
