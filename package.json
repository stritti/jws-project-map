{
  "name": "jws-project-map",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev",
    "build": "run-p type-check build-only",
    "budget": "node scripts/check-bundle-budget.cjs",
    "build:prod": "bun run build && bun run budget",
    "lint": "eslint .",
    "build-only": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "update:browserlist": "bunx browserslist@latest --update-db",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/img/cropped-joerg-wolff-stiftung.png",
    "optimize-images": "bun run scripts/optimize-images.mjs",
    "mcp": "bun run scripts/mcp-server.ts",
    "release:pr": "release-please release-pr --token=$GITHUB_TOKEN",
    "release:manifest": "release-please manifest --token=$GITHUB_TOKEN",
    "commit": "git-cz"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.29",
    "caniuse-lite": "^1.0.30001814",
    "dompurify": "^3.4.17",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.path.drag": "^0.0.6",
    "marked": "^18.1.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-leaflet-markercluster": "^0.6.1",
    "vue-router": "^5.3.1",
    "vue3-markdown-it": "^1.0.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/bi": "^1.2.7",
    "@lhci/cli": "^0.15.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@netlify/plugin-lighthouse": "^6.0.4",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "git-cz": "^4.9.0",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "rollup": "^4.64.7",
    "release-please": "^17.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.12",
    "workbox-build": "^7.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "commitlint": {
      "extends": [
        "@commitlint/config-conventional"
      ]
    }
  }
}
